USER_LANG = {}

def main_kb_json(lang="en"):
    t = TEXTS.get(lang, TEXTS["en"])
    return {
        "inline_keyboard": [
            [{"text": t["lang_btn"], "callback_data": "wavy_lang_menu", "style": "success"}],
            [{"text": "🔄 All-in-One File Converter", "callback_data": "wavy_conv", "style": "primary"}],
            [{"text": "🎬 AI Video Subtitles (Top)", "callback_data": "wavy_sub", "style": "primary"}],
            [
                {"text": "📥 Video Downloader", "callback_data": "wavy_dl", "style": "primary"},
                {"text": "🎵 Video to MP3", "callback_data": "wavy_mp3", "style": "primary"}
            ],
            [
                {"text": "📝 Song Lyrics", "callback_data": "wavy_lyrics", "style": "primary"},
                {"text": "🖼 Sticker & Photo", "callback_data": "wavy_sticker", "style": "primary"}
            ],
            [
                {"text": "🔳 QR Code Maker", "callback_data": "wavy_qr", "style": "primary"},
                {"text": "🎧 VC Music Player", "callback_data": "wavy_vc", "style": "primary"}
            ],
            [{"text": "📖 How to Use (Step-by-Step Guide)", "callback_data": "wavy_guide", "style": "success"}]
        ]
    }

LANG_KB_JSON = {
    "inline_keyboard": [
        [
            {"text": "🇬🇧 English", "callback_data": "setlang_en", "style": "primary"},
            {"text": "🇮🇳 Hinglish / हिंदी", "callback_data": "setlang_hi", "style": "primary"}
        ],
        [
            {"text": "🇪🇸 Español", "callback_data": "setlang_es", "style": "primary"},
            {"text": "🇸🇦 العربية", "callback_data": "setlang_ar", "style": "primary"}
        ],
        [{"text": "🇷🇺 Русский", "callback_data": "setlang_ru", "style": "primary"}],
        [{"text": "🔙 Back", "callback_data": "feat_menu", "style": "success"}]
    ]
}

def _tg_api(method, payload):
    req = urllib.request.Request(
        f"https://api.telegram.org/bot{config.BOT_TOKEN}/{method}",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    urllib.request.urlopen(req, timeout=10).read()

@app.on_message(filters.command(["start", "features", "help"]) & filters.private, group=-25)
async def show_features(_, m: Message):
    lang = USER_LANG.get(m.from_user.id, "en") if m.from_user else "en"
    await asyncio.to_thread(_tg_api, "sendPhoto", {
        "chat_id": m.chat.id,
        "photo": PHOTO_URL,
        "caption": TEXTS[lang]["main"],
        "parse_mode": "HTML",
        "reply_markup": main_kb_json(lang)
    })
    m.stop_propagation()

@app.on_callback_query(filters.regex(r"^(feat_menu|wavy_|setlang_)"), group=-25)
async def cb_wavy(_, cq: CallbackQuery):
    await cq.answer()
    uid = cq.from_user.id
    lang = USER_LANG.get(uid, "en")
    data = cq.data
    base = {"chat_id": cq.message.chat.id, "message_id": cq.message.id, "parse_mode": "HTML"}

    if data == "wavy_lang_menu":
        base.update({"caption": "🌐 <b>Select Your Preferred Language:</b>", "reply_markup": LANG_KB_JSON})
    elif data.startswith("setlang_"):
        new_lang = data.split("_")[1]
        USER_LANG[uid] = new_lang
        base.update({"caption": TEXTS[new_lang]["main"], "reply_markup": main_kb_json(new_lang)})
    elif data == "feat_menu":
        base.update({"caption": TEXTS[lang]["main"], "reply_markup": main_kb_json(lang)})
    elif data in TEXTS[lang]["info"]:
        back_kb = {"inline_keyboard": [[{"text": TEXTS[lang]["back"], "callback_data": "feat_menu", "style": "success"}]]}
        base.update({"caption": TEXTS[lang]["info"][data], "reply_markup": back_kb})

    try:
        await asyncio.to_thread(_tg_api, "editMessageCaption", base)
    except Exception:
        base["text"] = base.pop("caption")
        await asyncio.to_thread(_tg_api, "editMessageText", base)
    cq.stop_propagation()

@app.on_message(filters.private & filters.regex(r"^https?://(www\.)?(youtube\.com|youtu\.be|instagram\.com)/"), group=-25)
async def auto_dl(_, m: Message):
    url = m.text.strip().split()[0]
    st = await m.reply_text("⏳ <b>Downloading HD Video...</b>")
    out = f"/tmp/dl_{m.id}.mp4"
    try:
        p = await asyncio.create_subprocess_exec("yt-dlp", "-f", "best[ext=mp4][height<=720]/best", "-o", out, "--no-playlist", url)
        await p.communicate()
        if os.path.exists(out):
            await m.reply_video(out, caption="✅ <b>Downloaded via Wavy</b>")
            await st.delete()
        else:
            await st.edit_text("❌ Download failed.")
    finally:
        if os.path.exists(out): os.remove(out)
    m.stop_propagation()
